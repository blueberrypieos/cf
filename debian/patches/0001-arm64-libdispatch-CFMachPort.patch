Description: Support arm64 traps, current libdispatch, and the public CFMachPort API
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-01

--- a/CFInternal.h
+++ b/CFInternal.h
@@ -20,6 +20,7 @@
  *
  * @APPLE_LICENSE_HEADER_END@
  */
+/* Modified 2026-11-01: HALT traps on arm64 (APSL 2.0 section 2.2(b)). */
 
 /*	CFInternal.h
 	Copyright (c) 1998-2014, Apple Inc. All rights reserved.
@@ -140,7 +141,9 @@ CF_PRIVATE CFIndex __CFActiveProcessorCo
 #define __builtin_unreachable() do { } while (0)
 #endif
 
-#if defined(__i386__) || defined(__x86_64__)
+#if defined(__arm64__) || defined(__aarch64__)
+    #define HALT do { __builtin_trap(); kill(getpid(), 9); __builtin_unreachable(); } while (0)
+#elif defined(__i386__) || defined(__x86_64__)
     #if defined(__GNUC__)
         #define HALT do {asm __volatile__("int3"); kill(getpid(), 9); __builtin_unreachable(); } while (0)
     #elif defined(_MSC_VER)
