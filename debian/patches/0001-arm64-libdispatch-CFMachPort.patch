@@ -56,7 +57,7 @@
 #include <pthread/private.h>
 #include <os/voucher_private.h>
 extern mach_port_t _dispatch_get_main_queue_port_4CF(void);
-extern void _dispatch_main_queue_callback_4CF(mach_msg_header_t *msg);
